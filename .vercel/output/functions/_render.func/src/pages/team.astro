---
import Layout from '../layouts/Layout.astro';
import config from '../config';
---

<Layout title={`Our Teams - ${config.serverName}`}>
  <main class="relative min-h-screen w-full flex flex-col items-center p-6 md:p-12 overflow-y-auto">

    <div class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat" style={`background-image: url('${config.backgroundImage}');`}></div>
    <div class="fixed inset-0 -z-10 bg-black/93"></div>
    <div class="fixed inset-0 -z-10" style={`background: linear-gradient(to top, ${config.hueColor}40 0%, ${config.hueColor}1a 50%, transparent 100%);`}></div>

    <div class="w-full max-w-4xl flex justify-between items-center z-10 mb-12">
      <a href="/" class="corner-card px-4 py-2 rounded-[0.4rem] backdrop-blur-md text-white font-bold text-sm tracking-wider uppercase transition-all duration-300 flex items-center gap-2 border border-white/10 hover:border-white/30">
        ← Kembali
      </a>
      {config.logo && <img src={config.logo} alt={config.serverName} class="h-24 w-auto object-contain" />}
    </div>

    <div class="w-full max-w-4xl z-10 text-center mb-12">
      <h1 class="text-white font-black text-4xl md:text-5xl tracking-widest uppercase mb-3 drop-shadow-md">
        Our Teams
      </h1>
      <p class="text-white text-sm md:text-base tracking-wide">
        Orang-orang hebat di balik berjalannya {config.serverName}.
      </p>
    </div>

    <div class="w-full max-w-4xl z-10 flex flex-col gap-12 pb-16">
      
      {config.teamSections.map((section) => (
        <div class="flex flex-col gap-4">

          <div class="border-b border-white/10 pb-2">
            <h2 class="text-white font-black text-2xl md:text-3xl tracking-wider uppercase" style={`color: ${config.hueColor};`}>
              {section.category}
            </h2>
            <p class="text-white font-medium text-xs md:text-sm tracking-wide mt-1">
              {section.description}
            </p>
          </div>

          <div class:list={[
            'grid grid-cols-1 gap-4',
            section.fullWidth
              ? 'w-full'
              : 'sm:grid-cols-2 md:grid-cols-3'
          ]}>
            {section.members.map((member) => (
              <div class:list={[
                'corner-card p-5 rounded-[0.4rem] backdrop-blur-md flex flex-col items-center text-center transition-all duration-300 border border-white/10 hover:border-white/30 bg-white/[0.02]',
                section.fullWidth && 'w-full'
              ]}>
                <div class:list={[
                  'w-20 h-20 bg-white/10 mb-3 overflow-hidden border border-white/20 flex items-center justify-center',
                  section.fullWidth ? 'rounded-[0.4rem]' : 'rounded-full'
                ]}>
                  <img src={member.avatar} alt={member.name} class="w-full h-full object-cover" onerror="this.style.display='none'" />
                  <!-- fallback jika gambar belum ada -->
                  <span class="text-white/40 text-xs absolute">Foto</span>
                </div>
                <h3 class="text-white font-bold text-base tracking-wider uppercase">{member.name}</h3>
                <p class="text-white/60 text-xs tracking-widest uppercase mt-1">{member.role}</p>
              </div>
            ))}
          </div>

        </div>
      ))}

    </div>

    <div class="w-full max-w-4xl z-10 text-center text-white/30 text-xs tracking-widest uppercase mt-auto pt-6 border-t border-white/5">
      {config.serverName} &copy; {new Date().getFullYear()}
    </div>

  </main>
</Layout>

<style>
  .corner-card {
    background-color: rgba(255, 255, 255, 0.04);
  }
  .corner-card:hover { 
    background-color: rgba(255, 255, 255, 0.08);
  }
</style>
