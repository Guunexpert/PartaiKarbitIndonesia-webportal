---
import Layout from '../layouts/Layout.astro';
import config from '../config';
import { getDiscordSession } from '../lib/discord-auth';

const user = await getDiscordSession(Astro.request.headers.get('cookie'));
---

<Layout title={`Lapor / Saran - ${config.serverName}`}>
	<main class="feedback-page" style={`--accent: ${config.hueColor}; --background: url('${config.backgroundImage}');`}>
		<div class="page-overlay"></div>
		<header class="feedback-header"><a class="back-link" href="/">← Portal</a><div class="brand"><img src={config.logo} alt={config.serverName} /><div><span>Community board</span><strong>Lapor / Saran</strong></div></div>{user ? <div class="user-chip"><span>{user.global_name || user.username}</span><a href="/api/auth/discord/logout">Keluar</a></div> : <a class="discord-button" href="/api/auth/discord/login">Masuk dengan Discord</a>}</header>
		<section class="intro"><p class="kicker">Bantu kami berkembang</p><h1>Suara komunitas,<br /><em>langsung terlihat.</em></h1><p class="intro-copy">Sampaikan bug atau ide untuk PKI-SMP. Postinganmu langsung masuk dan bisa dilihat pemain lain.</p></section>
		<section class="board-layout">
			<article class="submit-panel"><div class="section-label"><span>01</span><h2>Buat postingan</h2></div>
			{user ? <form id="feedback-form"><div class="type-switch"><label><input type="radio" name="kind" value="bug" checked /><span>💦 Bug report</span></label><label><input type="radio" name="kind" value="suggestion" /><span>💡 Saran baru</span></label></div><label>Judul<input id="feedback-title" maxlength="120" required placeholder="Apa yang terjadi atau ingin kamu lihat?" /></label><label>Detail<textarea id="feedback-body" maxlength="4000" required rows="6" placeholder="Ceritakan sedetail mungkin..."></textarea></label><button class="submit-button" type="submit">Kirim postingan <span>↗</span></button><p id="form-message" class="form-message" role="status"></p></form> : <div class="login-prompt"><div class="login-mark">PKI-SMP</div><h2>Login dulu untuk ikut posting.</h2><p>Gaskan posting bung.</p><a class="discord-button" href="/api/auth/discord/login">Login dengan Discord <span>↗</span></a></div>}
			</article>
			<section class="feed-panel"><div class="feed-heading"><div class="section-label"><span>02</span><h2>Papan komunitas</h2></div><div class="filters"><button class="filter active" data-filter="all">Semua</button><button class="filter" data-filter="bug">Bug</button><button class="filter" data-filter="suggestion">Saran</button></div></div><div id="feed" class="feed" aria-live="polite"><p class="feed-state">Memuat postingan...</p></div></section>
		</section>
	</main>
</Layout>

<script define:vars={{ viewerId: user?.id || null }}>
	const feed = document.querySelector('#feed'); let posts = []; let filter = 'all';
	const labels = { pending: 'Baru masuk', considered: 'Dipertimbangkan', planned: 'Akan dibuat', in_progress: 'Sedang dikerjakan', completed: 'Selesai', rejected: 'Ditolak' };
	const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[character]));
	const render = () => { const visible = posts.filter((post) => filter === 'all' || post.kind === filter); feed.innerHTML = visible.length ? visible.map((post) => `<article class="post"><div class="post-meta"><span class="kind ${post.kind}">${post.kind === 'bug' ? '💦 Bug' : '💡 Saran'}</span><span class="status">${labels[post.implementation_status] || labels.pending}</span><time>${new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(post.created_at))}</time></div><h3>${escapeHtml(post.title)}</h3><p>${escapeHtml(post.body).replace(/\n/g, '<br>')}</p><div class="post-footer"><span class="author">${escapeHtml(post.author_name)}</span><div class="reactions">${post.reactions.map((reaction) => `<button class="reaction ${reaction.selected ? 'selected' : ''}" data-post="${post.id}" data-reaction="${reaction.key}" title="${reaction.label}">${reaction.emoji} <b>${reaction.count}</b></button>`).join('')}</div></div></article>`).join('') : '<p class="feed-state">Belum ada postingan di kategori ini.</p>'; };
	const load = async () => { try { const response = await fetch('/api/submissions'); const result = await response.json(); if (!response.ok) throw new Error(result.error); posts = result.posts; render(); } catch (error) { feed.innerHTML = `<p class="feed-state error">${escapeHtml(error.message || 'Feed gagal dimuat.')}</p>`; } };
	document.querySelectorAll('.filter').forEach((button) => button.addEventListener('click', () => { filter = button.dataset.filter; document.querySelectorAll('.filter').forEach((item) => item.classList.toggle('active', item === button)); render(); }));
	feed.addEventListener('click', async (event) => { const button = event.target.closest('[data-reaction]'); if (!button || !viewerId) { if (!viewerId && button) window.location.href = '/api/auth/discord/login'; return; } button.disabled = true; try { const response = await fetch(`/api/submissions/${button.dataset.post}/reactions`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ key: button.dataset.reaction }) }); const result = await response.json(); if (!response.ok) throw new Error(result.error); posts.find((item) => item.id === button.dataset.post).reactions = result.reactions; render(); } catch (error) { window.alert(error.message || 'Reaction gagal disimpan.'); } });
	document.querySelector('#feedback-form')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const message = document.querySelector('#form-message'); const payload = { kind: form.kind.value, title: document.querySelector('#feedback-title').value, body: document.querySelector('#feedback-body').value }; message.textContent = 'Mengirim...'; try { const response = await fetch('/api/submissions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }); const result = await response.json(); if (!response.ok) throw new Error(result.error); posts.unshift(result.post); form.reset(); message.textContent = 'Postingan berhasil dikirim.'; render(); } catch (error) { message.textContent = error.message || 'Postingan gagal dikirim.'; } });
	load();
</script>

<style>
	.feedback-page { min-height:100vh; color:#f4f1eb; background:#111313 var(--background) center/cover fixed; position:relative; overflow:hidden; isolation:isolate; }.page-overlay { position:fixed; inset:0; z-index:-1; background:linear-gradient(115deg,rgba(12,15,15,.98) 8%,rgba(12,15,15,.88) 54%,rgba(12,15,15,.96)),linear-gradient(to top,var(--accent)33,transparent 55%); }.feedback-header { max-width:1380px; margin:auto; padding:26px clamp(20px,4vw,58px); display:flex; align-items:center; gap:24px; border-bottom:1px solid rgba(255,255,255,.1); }.back-link { color:#9ea6a2; text-decoration:none; font-size:12px; }.brand { display:flex; align-items:center; gap:11px; margin:auto; }.brand img { width:38px; height:38px; object-fit:contain; }.brand span,.brand strong { display:block; }.brand span,.kicker,.section-label span { color:var(--accent); text-transform:uppercase; letter-spacing:.18em; font-size:10px; font-weight:800; }.brand strong { font-size:13px; letter-spacing:.08em; margin-top:4px; }.user-chip { display:flex; gap:12px; align-items:center; font-size:12px; }.user-chip a { color:#aab2ad; }.discord-button,.submit-button { border:1px solid var(--accent); color:#fff; text-decoration:none; padding:11px 14px; background:color-mix(in srgb,var(--accent) 28%,transparent); font:inherit; font-size:11px; font-weight:700; cursor:pointer; }.intro { max-width:1380px; margin:0 auto; padding:clamp(55px,10vw,120px) clamp(20px,4vw,58px) 65px; }.intro h1 { font-size:clamp(42px,7vw,90px); line-height:.96; margin:14px 0 22px; }.intro h1 em { color:#aeb9b2; font-style:normal; }.intro-copy { max-width:480px; color:#a2aaa5; font-size:15px; line-height:1.7; }.board-layout { max-width:1380px; margin:auto; padding:0 clamp(20px,4vw,58px) 80px; display:grid; grid-template-columns:minmax(280px,.72fr) minmax(0,1.28fr); gap:28px; }.submit-panel,.feed-panel { border-top:1px solid rgba(255,255,255,.18); padding-top:18px; }.section-label { display:flex; gap:13px; align-items:center; }.section-label h2 { font-size:17px; margin:0; }.section-label span { opacity:.75; }.submit-panel form { display:grid; gap:15px; margin-top:28px; }.type-switch { display:grid; grid-template-columns:1fr 1fr; gap:8px; }.type-switch input { position:absolute; opacity:0; }.type-switch span { display:block; padding:13px 10px; border:1px solid rgba(255,255,255,.13); color:#9fa7a1; font-size:12px; cursor:pointer; }.type-switch input:checked + span { color:#fff; border-color:var(--accent); background:color-mix(in srgb,var(--accent) 20%,transparent); }.submit-panel label { color:#9da7a1; font-size:11px; display:grid; gap:7px; }.submit-panel input:not([type=radio]),.submit-panel textarea { width:100%; box-sizing:border-box; border:1px solid rgba(255,255,255,.13); background:rgba(255,255,255,.045); color:#fff; padding:12px; font:inherit; font-size:13px; outline:none; }.submit-panel input:focus,.submit-panel textarea:focus { border-color:var(--accent); }.submit-button { justify-self:start; }.submit-button span { margin-left:22px; }.form-message { color:#a9c9ac; font-size:11px; min-height:15px; }.login-prompt { margin-top:36px; border-left:2px solid var(--accent); padding:5px 0 8px 22px; }.login-mark { color:var(--accent); font-size:28px; }.login-prompt h2 { font-size:21px; margin:12px 0 8px; }.login-prompt p { color:#969e99; font-size:12px; line-height:1.6; margin-bottom:22px; }.feed-heading { display:flex; justify-content:space-between; gap:20px; align-items:start; }.filters { display:flex; gap:4px; }.filter { border:0; background:transparent; color:#7f8983; padding:6px 8px; cursor:pointer; font:inherit; font-size:11px; }.filter.active { color:#fff; border-bottom:1px solid var(--accent); }.feed { display:grid; gap:11px; margin-top:22px; }.post { border:1px solid rgba(255,255,255,.11); background:rgba(255,255,255,.045); padding:18px; }.post-meta,.post-footer { display:flex; align-items:center; gap:9px; }.post-meta { color:#7f8983; font-size:10px; }.post-meta time { margin-left:auto; }.kind { color:#d4b486; }.kind.suggestion { color:#9db8d0; }.status { border:1px solid rgba(255,255,255,.14); padding:4px 7px; color:#9ea9a2; }.post h3 { font-size:18px; margin:15px 0 8px; }.post > p { color:#a6ada8; font-size:12px; line-height:1.65; margin:0 0 18px; }.post-footer { border-top:1px solid rgba(255,255,255,.08); padding-top:12px; }.author { color:#8b958f; font-size:10px; }.reactions { display:flex; gap:4px; margin-left:auto; }.reaction { border:1px solid rgba(255,255,255,.12); background:rgba(0,0,0,.15); color:#b8c0bb; padding:5px 7px; cursor:pointer; font:inherit; font-size:12px; }.reaction:hover,.reaction.selected { border-color:var(--accent); background:color-mix(in srgb,var(--accent) 18%,transparent); color:#fff; }.reaction b { font-size:10px; font-weight:500; }.feed-state { color:#7f8983; font-size:12px; padding:32px 0; }.feed-state.error { color:#df9e9e; }
	@media (max-width:720px) { .feedback-header { flex-wrap:wrap; }.brand { order:-1; width:100%; justify-content:center; }.user-chip { margin-left:auto; }.intro { padding-top:60px; }.board-layout { grid-template-columns:1fr; }.feed-heading { flex-direction:column; gap:12px; }.post-meta { flex-wrap:wrap; }.post-meta time { margin-left:0; width:100%; }.post-footer { align-items:start; flex-direction:column; }.reactions { margin-left:0; }.discord-button { font-size:10px; } }
</style>

<style>
	.feedback-page { background:#000; overflow-y:auto; }
	.page-overlay { position:fixed; inset:0; background-image:linear-gradient(to top, color-mix(in srgb, var(--accent) 25%, transparent) 0%, color-mix(in srgb, var(--accent) 10%, transparent) 50%, transparent 100%), linear-gradient(rgba(0,0,0,.93), rgba(0,0,0,.93)), var(--background); background-position:center; background-size:cover; z-index:-1; }
	.feedback-header,.intro,.board-layout { max-width:64rem; padding-left:1.5rem; padding-right:1.5rem; }
	.feedback-header { margin:0 auto; padding-top:1.5rem; padding-bottom:1.5rem; border-bottom:0; }
	.feedback-header .back-link { order:0; border:1px solid rgba(255,255,255,.1); border-radius:.4rem; padding:.5rem 1rem; color:#fff; font-weight:700; letter-spacing:.08em; text-transform:uppercase; transition:all .3s; }
	.feedback-header .back-link:hover { border-color:rgba(255,255,255,.3); background:rgba(255,255,255,.1); color:#fff; }
	.brand { margin:auto; }
	.brand span { color:rgba(255,255,255,.5); }
	.brand strong { color:#fff; text-transform:uppercase; letter-spacing:.12em; }
	.discord-button { border-radius:.4rem; background:rgba(255,255,255,.04); border-color:rgba(255,255,255,.1); text-transform:uppercase; letter-spacing:.08em; transition:all .3s; }
	.discord-button:hover,.submit-button:hover { background:var(--accent); border-color:var(--accent); }
	.intro { margin:0 auto; padding-top:2rem; padding-bottom:2.5rem; text-align:center; }
	.intro h1 { color:#fff; font-size:clamp(2.25rem,6vw,3.75rem); font-weight:900; letter-spacing:.08em; text-transform:uppercase; line-height:1.1; margin:1rem 0 .75rem; }
	.intro h1 em { color:var(--accent); }
	.intro-copy { margin:0 auto; color:rgba(255,255,255,.75); font-size:.875rem; }
	.board-layout { margin:0 auto; padding-bottom:4rem; grid-template-columns:1fr; gap:2rem; }
	.submit-panel,.feed-panel { border:0; border-top:1px solid rgba(255,255,255,.1); padding-top:.75rem; }
	.submit-panel { max-width:42rem; width:100%; margin:0 auto; }
	.section-label { margin-bottom:1.25rem; }
	.section-label h2 { color:#fff; font-size:1.5rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
	.section-label span,.kicker { color:var(--accent); }
	.submit-panel form,.feed { margin-top:1rem; }
	.submit-panel form,.post { background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.1); border-radius:.4rem; padding:1.5rem; backdrop-filter:blur(12px); }
	.feed-panel { max-width:100%; }
	.feed-heading { align-items:center; }
	.type-switch span,.submit-panel input:not([type=radio]),.submit-panel textarea { border-color:rgba(255,255,255,.1); background:rgba(0,0,0,.25); }
	.submit-button { border-radius:.4rem; background:rgba(255,255,255,.04); text-transform:uppercase; letter-spacing:.08em; }
	.login-prompt { background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.1); border-left:3px solid var(--accent); border-radius:.4rem; padding:1.5rem; backdrop-filter:blur(12px); }
	.post { padding:1.25rem; }
	.post h3 { color:#fff; font-weight:800; }
	.post > p { color:rgba(255,255,255,.7); }
	@media (min-width:768px) { .feedback-header,.intro,.board-layout { padding-left:3rem; padding-right:3rem; }.feedback-header { padding-top:2.5rem; }.intro { padding-top:2.5rem; padding-bottom:3rem; } }
	@media (max-width:600px) { .feedback-header { gap:12px; }.feedback-header .brand { order:-1; }.user-chip { margin-left:0; }.feedback-header > .discord-button { font-size:9px; padding:9px 8px; }.intro h1 { letter-spacing:.04em; }.feed-heading { align-items:flex-start; } }
</style>
