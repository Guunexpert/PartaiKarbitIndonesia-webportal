---
import Layout from '../layouts/Layout.astro';
import config from '../config';
---

<Layout title={`Admin Panel - ${config.serverName}`}>
  <main class="admin-shell" style={`--accent: ${config.hueColor};`}>
    <aside class="sidebar">
      <div class="brand-block">
        {config.logo && <img src={config.logo} alt={config.serverName} />}
        <div><strong>{config.serverName}</strong><span>Control room</span></div>
      </div>
      <nav aria-label="Navigasi admin">
        <a class="nav-link active" href="#overview">Overview</a><a class="nav-link" href="#events">Events</a><a class="nav-link" href="#announcement">Announcement</a><a class="nav-link" href="#feedback">Reports & suggestions</a><a class="nav-link" href="#activity">Activity log</a>
      </nav>
      <a class="back-link" href="/">Back to portal</a>
    </aside>
    <div class="panel-content">
      <header class="topbar"><div><p class="eyebrow">Admin workspace</p><h1>Server control room</h1></div><div class="topbar-actions"><div class="live-state"><i></i><span id="save-status">Supabase mode</span></div><form method="post" action="/api/auth/logout"><button class="logout-button" type="submit">Log out</button></form></div></header>
      <div class="notice-bar"><span class="notice-mark">!</span><p>Perubahan tersimpan di Supabase dan dibaca oleh portal dari semua perangkat. Update publik berjalan otomatis setiap beberapa detik.</p></div>
      <section id="overview" class="dashboard-grid">
        <article class="stat-card accent-card"><span>Server status</span><strong id="server-status">Online</strong><small id="server-uptime">Ready for players</small></article><article class="stat-card"><span>Active events</span><strong id="event-count">0</strong><small>Visible in portal</small></article><article class="stat-card"><span>Last update</span><strong id="last-update">Just now</strong><small>Browser storage</small></article>
      </section>
      <section class="workspace-grid">
        <article id="events" class="workspace-card event-card"><div class="section-heading"><div><p class="eyebrow">Content schedule</p><h2>Manage events</h2></div><span class="count-pill" id="event-pill">0 events</span></div>
          <form id="event-form" class="event-form"><input type="hidden" id="event-id" /><label>Event name<input id="event-title" required placeholder="Contoh: Event Spleef" /></label><div class="form-row"><label>Date<input id="event-date" type="date" required /></label><label>Time<input id="event-time" type="time" required /></label></div><label>Description<textarea id="event-description" rows="3" required placeholder="Tulis detail singkat event..."></textarea></label><div class="form-actions"><button class="button primary" type="submit" id="event-submit">Add event</button><button class="button ghost" type="button" id="event-cancel" hidden>Cancel edit</button></div></form>
          <div id="event-list" class="event-list" aria-live="polite"></div>
        </article>
        <div class="side-stack"><article id="announcement" class="workspace-card"><div class="section-heading"><div><p class="eyebrow">Front page signal</p><h2>Announcement</h2></div><span class="live-tag">Live</span></div><label>Message<textarea id="announcement-input" rows="4" placeholder="Tulis pengumuman untuk pemain..."></textarea></label><button class="button primary full-width" id="announcement-save" type="button">Publish announcement</button></article>
          <article class="workspace-card status-card"><div class="section-heading"><div><p class="eyebrow">Availability</p><h2>Server status</h2></div><span class="status-dot" id="status-dot"></span></div><p id="status-copy">Players can join the server.</p><button class="button status-button" id="status-toggle" type="button">Set maintenance mode</button></article></div>
      </section>
      <section id="changelog" class="workspace-card changelog-admin-card"><div class="section-heading"><div><p class="eyebrow">Release notes</p><h2>Manage changelog</h2></div><span class="count-pill" id="changelog-pill">0 updates</span></div>
        <form id="changelog-form" class="changelog-form"><label>Version<input id="changelog-version" required placeholder="Contoh: 1.1.0" /></label><label>Update title<input id="changelog-title" required placeholder="Contoh: Event system live" /></label><label>Details<textarea id="changelog-description" rows="2" required placeholder="Jelaskan perubahan terbaru..."></textarea></label><button class="button primary" type="submit">Publish changelog</button></form>
        <div id="admin-changelog-list" class="admin-changelog-list"></div>
      </section>
      <section id="feedback" class="workspace-card feedback-admin-card"><div class="section-heading"><div><p class="eyebrow">Community board</p><h2>Reports & suggestions</h2></div><select id="feedback-filter" class="admin-select"><option value="all">All posts</option><option value="bug">Bug reports</option><option value="suggestion">Suggestions</option><option value="active">Active only</option></select></div><div id="feedback-admin-list" class="feedback-admin-list"><p class="empty-state">Loading feedback...</p></div></section>
      <section id="activity" class="workspace-card activity-card"><div class="section-heading"><div><p class="eyebrow">Audit trail</p><h2>Recent activity</h2></div><button class="text-button" id="clear-activity" type="button">Clear log</button></div><div id="activity-list" class="activity-list"></div></section>
    </div>
  </main>
</Layout>

<script define:vars={{ initialEvent: config.serverInfo.latestNews }}>
  let state = { events: [{ id: 'default', title: initialEvent.title, date: '2026-09-04', time: '20:00', description: initialEvent.description }], announcement: '', online: true, changelog: [], activity: [], updated: new Date().toISOString() };
  const $ = (id) => document.getElementById(id);
  const log = (text) => { state.activity.unshift({ text, time: new Date().toISOString() }); state.activity = state.activity.slice(0, 8); };
  const save = async (message) => { try { const response = await fetch('/api/admin/state', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(state) }); const result = await response.json(); if (!response.ok) throw new Error(result.error || 'State save failed'); state = { ...result, activity: state.activity || [] }; $('save-status').textContent = message; render(); } catch (error) { $('save-status').textContent = error instanceof Error ? error.message : 'Save failed'; } };
  const formatDate = (date) => new Intl.DateTimeFormat('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(`${date}T00:00:00`));
  const render = () => { $('event-count').textContent = state.events.length; $('event-pill').textContent = `${state.events.length} event${state.events.length === 1 ? '' : 's'}`; $('changelog-pill').textContent = `${state.changelog.length} update${state.changelog.length === 1 ? '' : 's'}`; $('last-update').textContent = new Intl.DateTimeFormat('id-ID', { hour: '2-digit', minute: '2-digit' }).format(new Date(state.updated)); $('server-status').textContent = state.online ? 'Online' : 'Maintenance'; $('server-uptime').textContent = state.online ? 'Ready for players' : 'Join access paused'; $('status-copy').textContent = state.online ? 'Players can join the server.' : 'Portal is in maintenance mode.'; $('status-toggle').textContent = state.online ? 'Set maintenance mode' : 'Bring server online'; $('status-dot').className = `status-dot ${state.online ? 'online' : 'offline'}`; $('announcement-input').value = state.announcement; $('event-list').innerHTML = state.events.length ? state.events.map((event) => `<div class="event-row"><div><strong>${event.title}</strong><span>${formatDate(event.date)} at ${event.time} WIB</span><p>${event.description}</p></div><div class="row-actions"><button class="icon-button" data-edit="${event.id}" type="button">Edit</button><button class="icon-button danger" data-delete="${event.id}" type="button">Delete</button></div></div>`).join('') : '<p class="empty-state">No events scheduled yet.</p>'; $('admin-changelog-list').innerHTML = state.changelog.map((item) => `<div class="admin-changelog-row"><strong>${item.version}</strong><div><b>${item.title}</b><p>${item.description}</p></div></div>`).join(''); $('activity-list').innerHTML = state.activity.map((item) => `<div class="activity-row"><i></i><span>${item.text}</span><time>${new Intl.DateTimeFormat('id-ID', { hour: '2-digit', minute: '2-digit' }).format(new Date(item.time))}</time></div>`).join(''); };
  const resetForm = () => { $('event-form').reset(); $('event-id').value = ''; $('event-submit').textContent = 'Add event'; $('event-cancel').hidden = true; };
  $('event-form').addEventListener('submit', async (event) => { event.preventDefault(); const id = $('event-id').value || Date.now().toString(); const item = { id, title: $('event-title').value, date: $('event-date').value, time: $('event-time').value, description: $('event-description').value }; const index = state.events.findIndex((entry) => entry.id === id); if (index >= 0) { state.events[index] = item; log(`Updated ${item.title}`); } else { state.events.push(item); log(`Added ${item.title}`); } await save('Saved just now'); resetForm(); });
  $('event-cancel').addEventListener('click', resetForm);
  $('changelog-form').addEventListener('submit', async (event) => { event.preventDefault(); const item = { version: $('changelog-version').value, title: $('changelog-title').value, description: $('changelog-description').value }; state.changelog.unshift(item); log(`Published changelog ${item.version}`); await save('Changelog published'); $('changelog-form').reset(); });
  $('event-list').addEventListener('click', (event) => { const editId = event.target.dataset.edit; const deleteId = event.target.dataset.delete; if (editId) { const item = state.events.find((entry) => entry.id === editId); $('event-id').value = item.id; $('event-title').value = item.title; $('event-date').value = item.date; $('event-time').value = item.time; $('event-description').value = item.description; $('event-submit').textContent = 'Save changes'; $('event-cancel').hidden = false; $('event-title').focus(); } if (deleteId) { const item = state.events.find((entry) => entry.id === deleteId); state.events = state.events.filter((entry) => entry.id !== deleteId); log(`Removed ${item.title}`); save('Saved just now'); } });
  $('announcement-save').addEventListener('click', () => { state.announcement = $('announcement-input').value.trim(); log(state.announcement ? 'Published a new announcement' : 'Cleared the announcement'); save('Published just now'); }); $('status-toggle').addEventListener('click', () => { state.online = !state.online; log(state.online ? 'Server marked online' : 'Maintenance mode enabled'); save('Status updated'); }); $('clear-activity').addEventListener('click', () => { state.activity = []; save('Activity cleared'); });
  const feedbackStatuses = { pending: 'Pending', considered: 'Considered', planned: 'Planned', in_progress: 'In progress', completed: 'Completed', rejected: 'Rejected' };
  const escapeFeedbackHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[character]));
  let feedbackPosts = [];
  const renderFeedback = () => { const selected = $('feedback-filter').value; const filtered = feedbackPosts.filter((post) => selected === 'all' || selected === post.kind || selected === 'active' && !post.deleted_at); $('feedback-admin-list').innerHTML = filtered.length ? filtered.map((post) => `<div class="feedback-admin-row ${post.deleted_at ? 'deleted' : ''}"><div class="feedback-admin-copy"><div><span class="admin-kind">${post.kind === 'bug' ? 'Bug' : 'Suggestion'}</span><time>${new Date(post.created_at).toLocaleString('id-ID')}</time></div><strong>${escapeFeedbackHtml(post.title)}</strong><p>${escapeFeedbackHtml(post.body).replace(/\n/g, '<br>')}</p><small>by ${escapeFeedbackHtml(post.author_name)} · ${post.reactions.map((reaction) => `${escapeFeedbackHtml(reaction.emoji)} ${reaction.count}`).join(' ')}</small></div><div class="feedback-admin-actions"><select data-status="${escapeFeedbackHtml(post.id)}" ${post.deleted_at ? 'disabled' : ''}>${Object.entries(feedbackStatuses).map(([key, label]) => `<option value="${key}" ${key === post.implementation_status ? 'selected' : ''}>${label}</option>`).join('')}</select><button class="icon-button danger" data-feedback-delete="${escapeFeedbackHtml(post.id)}" type="button" ${post.deleted_at ? 'disabled' : ''}>Delete</button></div></div>`).join('') : '<p class="empty-state">No feedback found.</p>'; };
  const loadFeedback = async () => { try { const response = await fetch('/api/admin/submissions'); const result = await response.json(); if (!response.ok) throw new Error(result.error); feedbackPosts = result.posts; renderFeedback(); } catch (error) { $('feedback-admin-list').innerHTML = `<p class="empty-state">${error.message || 'Unable to load feedback.'}</p>`; } };
  $('feedback-filter').addEventListener('change', renderFeedback);
  $('feedback-admin-list').addEventListener('change', async (event) => { const select = event.target.closest('[data-status]'); if (!select) return; await fetch('/api/admin/submissions', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: select.dataset.status, implementation_status: select.value }) }); loadFeedback(); });
  $('feedback-admin-list').addEventListener('click', async (event) => { const button = event.target.closest('[data-feedback-delete]'); if (!button || !window.confirm('Delete this post?')) return; await fetch('/api/admin/submissions', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: button.dataset.feedbackDelete, deleted: true }) }); loadFeedback(); });
  fetch('/api/admin/state').then(async (response) => { const result = await response.json(); if (!response.ok) throw new Error(result.error || 'State load failed'); return result; }).then((remoteState) => { state = { ...remoteState, activity: state.activity || [] }; render(); }).catch((error) => { render(); $('save-status').textContent = error instanceof Error ? error.message : 'Supabase not connected'; });
  loadFeedback();
</script>

<style>
  :global(html) { scroll-behavior: smooth; } .admin-shell { min-height:100vh; display:flex; color:#f4f5f7; background:#101214; background-image:radial-gradient(circle at 76% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 32rem),linear-gradient(135deg,#111416,#181d1d); } .sidebar { width:240px; flex:0 0 240px; border-right:1px solid rgba(255,255,255,.08); padding:28px 20px; display:flex; flex-direction:column; } .brand-block { display:flex; align-items:center; gap:11px; margin-bottom:58px; } .brand-block img { width:40px; height:40px; object-fit:contain; } .brand-block strong,.brand-block span { display:block; } .brand-block strong { font-size:14px; letter-spacing:.08em; } .brand-block span { color:#7c8584; font-size:10px; text-transform:uppercase; letter-spacing:.14em; margin-top:4px; } nav { display:grid; gap:8px; } .nav-link,.back-link { color:#858d8d; font-size:13px; text-decoration:none; padding:11px 12px; border-left:2px solid transparent; } .nav-link:hover,.nav-link.active { color:#fff; background:rgba(255,255,255,.06); border-left-color:var(--accent); } .back-link { margin-top:auto; border-top:1px solid rgba(255,255,255,.08); padding-top:20px; } .panel-content { width:min(100%,1280px); padding:42px clamp(20px,4vw,64px); } .topbar { display:flex; justify-content:space-between; align-items:flex-start; gap:24px; margin-bottom:30px; } .eyebrow { color:var(--accent); font-size:10px; font-weight:800; letter-spacing:.18em; margin:0 0 8px; text-transform:uppercase; } .topbar h1 { font-size:clamp(26px,4vw,42px); line-height:1; letter-spacing:-.02em; margin:0; } .live-state { display:flex; align-items:center; gap:8px; color:#a9b1ae; font-size:12px; } .live-state i,.status-dot { width:8px; height:8px; border-radius:50%; background:#6ee7a5; box-shadow:0 0 12px #6ee7a5; } .notice-bar { display:flex; gap:12px; align-items:center; border:1px solid rgba(255,255,255,.1); padding:12px 15px; margin-bottom:25px; background:rgba(255,255,255,.035); } .notice-bar p { margin:0; color:#aeb6b3; font-size:12px; line-height:1.5; } .notice-mark { color:#121717; background:var(--accent); width:20px; height:20px; display:grid; place-items:center; font-weight:900; border-radius:50%; } .dashboard-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:25px; } .stat-card,.workspace-card { background:rgba(20,25,25,.82); border:1px solid rgba(255,255,255,.09); } .stat-card { padding:19px 20px; min-height:108px; } .stat-card span,.stat-card small { display:block; color:#8b9591; font-size:11px; } .stat-card strong { display:block; font-size:27px; margin:12px 0 5px; } .accent-card strong { color:var(--accent); } .workspace-grid { display:grid; grid-template-columns:minmax(0,1.45fr) minmax(290px,.7fr); gap:14px; align-items:start; } .workspace-card { padding:23px; } .section-heading { display:flex; align-items:start; justify-content:space-between; gap:18px; margin-bottom:20px; } .section-heading h2 { font-size:20px; margin:0; } .count-pill,.live-tag { color:var(--accent); border:1px solid color-mix(in srgb,var(--accent) 45%,transparent); padding:5px 8px; font-size:10px; text-transform:uppercase; letter-spacing:.1em; white-space:nowrap; } .live-tag { color:#6ee7a5; border-color:rgba(110,231,165,.3); } .event-form { display:grid; gap:12px; padding-bottom:23px; border-bottom:1px solid rgba(255,255,255,.08); } .form-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; } label { display:grid; gap:7px; color:#a7afad; font-size:11px; text-transform:uppercase; letter-spacing:.1em; } input,textarea { width:100%; box-sizing:border-box; color:#f5f5f2; background:#111515; border:1px solid rgba(255,255,255,.12); padding:11px 12px; font:inherit; font-size:13px; text-transform:none; letter-spacing:0; outline:none; } input:focus,textarea:focus { border-color:var(--accent); } textarea { resize:vertical; } .form-actions { display:flex; gap:9px; } .button { border:0; padding:11px 14px; font:inherit; font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.1em; cursor:pointer; } .primary { color:#101414; background:var(--accent); } .primary:hover { filter:brightness(1.15); } .ghost,.status-button { color:#dbe0dc; background:rgba(255,255,255,.08); } .event-list { display:grid; } .event-row { display:flex; justify-content:space-between; gap:15px; padding:17px 0; border-bottom:1px solid rgba(255,255,255,.07); } .event-row strong,.event-row span,.event-row p { display:block; } .event-row strong { font-size:14px; } .event-row span { color:var(--accent); font-size:11px; margin:5px 0; } .event-row p { color:#939c99; font-size:12px; line-height:1.5; margin:0; } .row-actions { display:flex; align-items:start; gap:5px; } .icon-button,.text-button { background:none; border:0; color:#8f9996; font:inherit; font-size:10px; cursor:pointer; text-transform:uppercase; letter-spacing:.08em; } .icon-button:hover,.text-button:hover { color:#fff; } .danger:hover { color:#f28b8b; } .side-stack { display:grid; gap:14px; } .full-width { width:100%; margin-top:15px; } .status-card { border-left:2px solid var(--accent); } .status-card p { color:#9ba4a1; font-size:13px; margin:0 0 18px; } .status-dot.offline { background:#f28b8b; box-shadow:0 0 12px #f28b8b; } .status-button { width:100%; } .activity-card { margin-top:14px; } .activity-list { display:grid; } .activity-row { display:flex; align-items:center; gap:10px; border-top:1px solid rgba(255,255,255,.07); padding:12px 0; font-size:12px; color:#c3c9c6; } .activity-row i { width:6px; height:6px; background:var(--accent); border-radius:50%; } .activity-row time { margin-left:auto; color:#717a77; font-size:11px; } .empty-state { color:#7e8985; font-size:12px; padding:14px 0; } @media (max-width:800px) { .admin-shell { display:block; } .sidebar { width:auto; padding:18px 20px; border-right:0; border-bottom:1px solid rgba(255,255,255,.08); } .brand-block { margin-bottom:18px; } .sidebar nav { display:flex; overflow:auto; } .nav-link { white-space:nowrap; } .back-link { display:none; } .panel-content { padding:28px 16px; } .dashboard-grid { grid-template-columns:1fr 1fr; } .stat-card:last-child { grid-column:1 / -1; } .workspace-grid { grid-template-columns:1fr; } } @media (max-width:460px) { .dashboard-grid { grid-template-columns:1fr; } .stat-card:last-child { grid-column:auto; } .form-row { grid-template-columns:1fr; } .topbar { display:block; } .live-state { margin-top:18px; } .workspace-card { padding:17px; } }
</style>

<style>
  .changelog-admin-card { margin-top: 14px; }
  .changelog-form { display: grid; gap: 12px; max-width: 760px; margin-bottom: 22px; }
  .admin-changelog-list { display: grid; gap: 0; }
  .admin-changelog-row { display: flex; gap: 18px; border-top: 1px solid rgba(255,255,255,.07); padding: 14px 0; }
  .admin-changelog-row > strong { min-width: 52px; color: var(--accent); font-size: 12px; }
  .admin-changelog-row b { font-size: 13px; }
  .admin-changelog-row p { margin: 4px 0 0; color: #939c99; font-size: 12px; line-height: 1.5; }
  .feedback-admin-card { margin-top: 14px; }.admin-select,.feedback-admin-actions select { border:1px solid rgba(255,255,255,.14); background:#171b1b; color:#dfe5e1; padding:9px 10px; font:inherit; font-size:11px; }.feedback-admin-list { display:grid; gap:0; }.feedback-admin-row { display:flex; justify-content:space-between; gap:20px; border-top:1px solid rgba(255,255,255,.07); padding:17px 0; }.feedback-admin-row.deleted { opacity:.45; }.feedback-admin-copy { min-width:0; }.feedback-admin-copy > div { display:flex; gap:12px; align-items:center; color:#7f8983; font-size:10px; }.feedback-admin-copy time { font-size:10px; }.admin-kind { color:var(--accent); text-transform:uppercase; letter-spacing:.1em; }.feedback-admin-copy strong { display:block; margin-top:8px; font-size:14px; }.feedback-admin-copy p { color:#939c99; font-size:12px; line-height:1.5; margin:5px 0; }.feedback-admin-copy small { color:#6e7772; font-size:10px; }.feedback-admin-actions { display:flex; align-items:start; gap:8px; flex:0 0 auto; }.feedback-admin-actions .icon-button { padding:9px 10px; }
  .topbar-actions { display: flex; align-items: center; gap: 16px; }
  .logout-button { border: 1px solid rgba(255,255,255,.14); padding: 8px 10px; color: #aeb6b3; background: transparent; font: inherit; font-size: 10px; text-transform: uppercase; letter-spacing: .1em; cursor: pointer; }
  .logout-button:hover { color: #fff; border-color: var(--accent); }
  @media (max-width: 600px) { .feedback-admin-row { display:grid; }.feedback-admin-actions { justify-content:space-between; }.feedback-admin-actions select { flex:1; } }
  @media (max-width: 460px) { .topbar-actions { align-items: flex-start; justify-content: space-between; margin-top: 18px; } }
</style>