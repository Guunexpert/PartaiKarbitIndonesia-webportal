---
import Layout from '../layouts/Layout.astro';
import config from '../config';
---

<Layout title={config.serverName}>
  <main class="relative min-h-screen w-full">

    <!-- Background -->
    <div class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat" style={`background-image: url('${config.backgroundImage}');`}></div>
    <div class="fixed inset-0 -z-10 bg-black/93"></div>
    <div class="fixed inset-0 -z-10" style={`background: linear-gradient(to top, ${config.hueColor}40 0%, ${config.hueColor}1a 50%, transparent 100%);`}></div>

    <!-- Mobile -->
    <div class="md:hidden flex flex-col gap-3 px-4 pt-6 pb-4">
      {config.logo && <img src={config.logo} alt={config.serverName} class="h-14 w-auto object-contain mx-auto mb-2" />}
      {config.links.map((link) => (
        <a href={link.href} class="corner-card flex items-center justify-center rounded-[0.4rem] backdrop-blur-md transition-all duration-300" style={`--card-color: ${link.color};`}>
          <span class="text-white font-black text-3xl tracking-widest uppercase card-label">{link.label}</span>
        </a>
      ))}
    </div>

    <!-- Desktop -->
    <div class="fixed inset-4 z-0 gap-3 hidden md:grid md:grid-cols-2 md:grid-rows-2">
      {config.links.map((link) => (
        <a href={link.href} class="corner-card flex items-center justify-center rounded-[0.4rem] backdrop-blur-md transition-all duration-300" style={`--card-color: ${link.color};`}>
          <span class="text-white font-black text-5xl tracking-widest uppercase card-label">{link.label}</span>
        </a>
      ))}
    </div>

    <div class="hidden md:flex fixed inset-0 items-center justify-center pointer-events-none z-10">
      {config.logo && <img src={config.logo} alt={config.serverName} class="h-24 w-auto object-contain" />}
    </div>

  </main>
</Layout>

<style>
  .corner-card {
    background-color: rgba(255, 255, 255, 0.04);
    width: 100%;
    height: 100%;
    min-height: 140px;
  }
  .corner-card:hover { background-color: var(--card-color); }
  .card-label { opacity: 0.25; transition: opacity 0.1s; }
  .corner-card:hover .card-label { opacity: 1; }
</style>
