---
import Layout from '../../layouts/Layout.astro';
import config from '../../config';

const hasError = Astro.url.searchParams.has('error');
---

<Layout title={`Admin Login - ${config.serverName}`}>
  <main class="login-shell" style={`--accent: ${config.hueColor};`}>
    <section class="login-card">
      {config.logo && <img src={config.logo} alt={config.serverName} />}
      <p class="eyebrow">Private workspace</p>
      <h1>Admin login</h1>
      <p class="intro">Masuk untuk mengelola event dan announcement server.</p>
      {hasError && <p class="error-message" role="alert">Username atau password salah.</p>}
      <form method="post" action="/api/auth/login">
        <label>Username<input name="username" autocomplete="username" required /></label>
        <label>Password<input name="password" type="password" autocomplete="current-password" required /></label>
        <button type="submit">Sign in</button>
      </form>
      <a href="/">Back to portal</a>
    </section>
  </main>
</Layout>

<style>
  .login-shell { min-height:100vh; display:grid; place-items:center; padding:24px; color:#f4f5f7; background:#101414; background-image:radial-gradient(circle at 50% 0%, color-mix(in srgb,var(--accent) 20%,transparent), transparent 32rem),linear-gradient(135deg,#111416,#181d1d); }.login-card { width:min(100%,390px); padding:34px; border:1px solid rgba(255,255,255,.1); background:rgba(20,25,25,.9); box-shadow:0 24px 70px rgba(0,0,0,.35); }.login-card img { width:58px; height:58px; object-fit:contain; margin-bottom:30px; }.eyebrow { color:var(--accent); font-size:10px; font-weight:800; letter-spacing:.18em; text-transform:uppercase; margin:0 0 8px; }.login-card h1 { font-size:32px; margin:0; }.intro { color:#98a19e; font-size:13px; line-height:1.5; margin:10px 0 24px; }.error-message { color:#ff9b9b; border-left:2px solid #ff7777; background:rgba(255,100,100,.08); padding:10px 12px; font-size:12px; }.login-card form { display:grid; gap:15px; }label { display:grid; gap:7px; color:#a7afad; font-size:11px; text-transform:uppercase; letter-spacing:.1em; }input { box-sizing:border-box; width:100%; color:#f5f5f2; background:#111515; border:1px solid rgba(255,255,255,.12); padding:12px; font:inherit; font-size:14px; outline:none; }input:focus { border-color:var(--accent); }.login-card button { border:0; padding:13px; margin-top:5px; color:#101414; background:var(--accent); font:inherit; font-size:11px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; cursor:pointer; }.login-card button:hover { filter:brightness(1.15); }.login-card > a { display:block; margin-top:22px; color:#89938f; font-size:12px; text-align:center; text-decoration:none; }.login-card > a:hover { color:#fff; }
</style>