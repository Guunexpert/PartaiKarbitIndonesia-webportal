---
import Layout from '../layouts/Layout.astro';
import config from '../config';
---

<Layout title={`FAQ - ${config.serverName}`}>
	<main class="relative min-h-screen w-full">
		<div class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat" style={`background-image: url('${config.backgroundImage}');`}></div>
		<div class="fixed inset-0 -z-10 bg-black/93"></div>
		<div class="fixed inset-0 -z-10" style={`background: linear-gradient(to top, ${config.hueColor}40 0%, ${config.hueColor}1a 50%, transparent 100%);`}></div>

		<div class="relative z-10 flex min-h-screen flex-col items-center justify-center px-4 text-center">
			{config.logo && <img src={config.logo} alt={config.serverName} class="mb-6 h-24 w-auto object-contain md:h-32" />}
			<p class="text-2xl font-black uppercase tracking-[0.2em] text-white md:text-4xl">Coming Soon</p>
		</div>
	</main>
</Layout>
